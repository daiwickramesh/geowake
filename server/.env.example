# ─────────────────────────────────────────────────────────────────────────────
# GeoWake server configuration. Copy to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
#
# The server validates this file on startup and refuses to boot when a
# REQUIRED value is missing or empty, so a misconfigured deploy fails loudly.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# The defaults below match the `postgres` service in ../docker-compose.yml
# (user: devuser, password: devpassword, database: geowakedb, port: 5432).
DATABASE_URL="postgresql://devuser:devpassword@localhost:5432/geowakedb?schema=public"

# Secret used to sign AND verify every GeoWake session token (HTTP + Socket.IO).
# Must be at least 32 characters. Generate one with:  openssl rand -base64 48
# Rotating this invalidates all existing sessions.
JWT_SECRET="replace-me-with-openssl-rand-base64-48"

# Google OAuth 2.0 **web** client ID (ends in .apps.googleusercontent.com).
# Must match the ID configured in the Google Cloud console for your origin, and
# must equal EXPO_PUBLIC_GOOGLE_CLIENT_ID in the client. This is a public
# identifier, not a secret — but the matching client *secret* must never be
# placed on this server or in the client bundle.
GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"

# ── OPTIONAL ────────────────────────────────────────────────────────────────

# HTTP port. Render injects PORT automatically.
PORT=5000

# NODE_ENV="production"

# Browser origins allowed to call the API. "*" (the default) allows any origin,
# which is safe because authentication uses a Bearer token rather than cookies.
# Lock it down in production, e.g. CORS_ORIGIN="https://geowake.example.com"
# CORS_ORIGIN="*"

# ── Session lifetimes ───────────────────────────────────────────────────────
# Password login / registration (also the default).
# JWT_EXPIRES_IN="7d"
# Google sign-in.
# GOOGLE_JWT_EXPIRES_IN="30d"

# ── AI parsing (Groq) ───────────────────────────────────────────────────────
# Without a key the AI endpoint still works: it falls back to regex radius
# parsing plus geocoding, and skips the model call.
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_TIMEOUT_MS=4000

# ── Geocoding (Photon, no key required) ─────────────────────────────────────
# GEOCODE_TIMEOUT_MS=5000

# ── Redis cache (optional) ──────────────────────────────────────────────────
# Alarms are cached for 60s. If Redis is unreachable the API transparently falls
# back to PostgreSQL, so this is entirely optional.
# The defaults below match the `redis` service in ../docker-compose.yml.
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# Leave empty for the local container; set it for managed providers
# (Upstash/Redis Cloud). Setting a password also enables TLS.
# REDIS_PASSWORD=""
