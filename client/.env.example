# ─────────────────────────────────────────────────────────────────────────────
# GeoWake client configuration. Copy to `.env` and adjust:
#   cp .env.example .env
#
# Everything prefixed with EXPO_PUBLIC_ is INLINED INTO THE PUBLIC BUNDLE at
# build time and is readable by anyone using the site. Never put a secret here
# (no client secret, no JWT secret, no database URL).
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the GeoWake API, including the /api prefix.
# Leave unset to auto-select: http://localhost:5000/api when the page is served
# from localhost/127.0.0.1, otherwise the default production URL below.
# EXPO_PUBLIC_API_URL="http://localhost:5000/api"
# EXPO_PUBLIC_API_URL="https://geowake-6lwr.onrender.com/api"

# Socket.IO server root. Defaults to EXPO_PUBLIC_API_URL with "/api" stripped.
# EXPO_PUBLIC_SOCKET_URL="https://geowake-6lwr.onrender.com"

# Google Identity Services web client ID. This is a public identifier and must
# match GOOGLE_CLIENT_ID configured on the server, plus the authorised origins
# in the Google Cloud console.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
